# ===========================================================================
# Spark Worker with PyTorch + CUDA
#
# Single Python version (3.12, official slim base) across CPU and GPU
# targets — matches Dockerfile and the native install so results and wheel
# bundles line up everywhere.
#
# CACHE STRATEGY:
#   Stage 'base-gpu' — Java + Spark (slow-ish, rarely changes)
#   Stage 'gpu'       — CUDA 12.8 torch + benchmark code (pip layer isolated)
#   Stage 'cpu'       — CPU-only worker
# Each pip layer only invalidates when the specific requirements file it
# installs from changes, because that file is COPYed immediately before it.
#
# Build targets:
#   CPU:  docker build --target cpu -t pytorch-spark-worker:cpu -f Dockerfile.worker .
#   GPU:  docker build --target gpu -t pytorch-spark-worker:gpu -f Dockerfile.worker .
# ===========================================================================

# ---------------------------------------------------------------------------
# Stage 0: GPU base — python:3.12-slim + Java + Spark
# No CUDA base image needed: the torch cu128 wheel (installed in the 'gpu'
# stage below) bundles its own CUDA/cuDNN runtime libs as pip dependencies.
# GPU access at `docker run --gpus all` time comes from the NVIDIA Container
# Toolkit / Docker Desktop mounting the host driver into the container
# regardless of base image — NVIDIA_DRIVER_CAPABILITIES below is what makes
# that mount happen.
# ---------------------------------------------------------------------------
FROM python:3.12-slim AS base-gpu

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl wget procps \
    && rm -rf /var/lib/apt/lists/*

# Java 17 JRE (pinned version)
RUN mkdir -p /opt/java && \
    wget -q https://github.com/adoptium/temurin17-binaries/releases/download/jdk-17.0.11%2B9/OpenJDK17U-jre_x64_linux_hotspot_17.0.11_9.tar.gz \
         -O /tmp/java.tar.gz && \
    tar -xzf /tmp/java.tar.gz -C /opt/java --strip-components=1 && \
    rm /tmp/java.tar.gz

ENV JAVA_HOME=/opt/java
ENV PATH="${JAVA_HOME}/bin:${PATH}"

# Spark 4.2.0 (already the pinned cluster version — unchanged)
RUN wget -q https://archive.apache.org/dist/spark/spark-4.2.0/spark-4.2.0-bin-hadoop3.tgz \
         -O /tmp/spark.tgz && \
    tar -xzf /tmp/spark.tgz -C /opt/ && \
    mv /opt/spark-4.2.0-bin-hadoop3 /opt/spark && \
    rm /tmp/spark.tgz

ENV SPARK_HOME=/opt/spark
ENV PATH="${SPARK_HOME}/bin:${SPARK_HOME}/sbin:${PATH}"
ENV PYSPARK_PYTHON=python
ENV NVIDIA_VISIBLE_DEVICES=all
ENV NVIDIA_DRIVER_CAPABILITIES=compute,utility

WORKDIR /app
RUN pip install --no-cache-dir --upgrade pip

# ---------------------------------------------------------------------------
# Stage 1: GPU Worker — CUDA 12.8 torch + deps on top of base-gpu
# ---------------------------------------------------------------------------
FROM base-gpu AS gpu

# Torch layer — isolated so it stays cached when only requirements-base.txt changes
COPY pytorch_benchmark/requirements-torch-gpu.txt /app/requirements-torch-gpu.txt
RUN pip install --no-cache-dir \
    --index-url https://download.pytorch.org/whl/cu128 \
    -r requirements-torch-gpu.txt

# Everything else — isolated so it stays cached when only torch's pin changes
COPY pytorch_benchmark/requirements-base.txt /app/requirements-base.txt
RUN pip install --no-cache-dir -r requirements-base.txt

# Benchmark code — only layer that changes during dev
COPY pytorch_benchmark/ /app/pytorch_benchmark/
ENV PYTHONPATH=/app
WORKDIR /app

# ---------------------------------------------------------------------------
# Stage 2: CPU Worker
# ---------------------------------------------------------------------------
FROM python:3.12-slim AS cpu

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl wget procps \
    && rm -rf /var/lib/apt/lists/*

# Java 17 (pinned version)
RUN mkdir -p /opt/java && \
    wget -q https://github.com/adoptium/temurin17-binaries/releases/download/jdk-17.0.11%2B9/OpenJDK17U-jre_x64_linux_hotspot_17.0.11_9.tar.gz \
         -O /tmp/java.tar.gz && \
    tar -xzf /tmp/java.tar.gz -C /opt/java --strip-components=1 && \
    rm /tmp/java.tar.gz

ENV JAVA_HOME=/opt/java
ENV PATH="${JAVA_HOME}/bin:${PATH}"

# Spark 4.2.0 (already the pinned cluster version — unchanged)
RUN wget -q https://archive.apache.org/dist/spark/spark-4.2.0/spark-4.2.0-bin-hadoop3.tgz \
         -O /tmp/spark.tgz && \
    tar -xzf /tmp/spark.tgz -C /opt/ && \
    mv /opt/spark-4.2.0-bin-hadoop3 /opt/spark && \
    rm /tmp/spark.tgz

ENV SPARK_HOME=/opt/spark
ENV PATH="${SPARK_HOME}/bin:${SPARK_HOME}/sbin:${PATH}"
ENV PYSPARK_PYTHON=python

WORKDIR /app
RUN pip install --no-cache-dir --upgrade pip

# Torch layer — isolated so it stays cached when only requirements-base.txt changes
COPY pytorch_benchmark/requirements-torch-cpu.txt /app/requirements-torch-cpu.txt
RUN pip install --no-cache-dir \
    --index-url https://download.pytorch.org/whl/cpu \
    -r requirements-torch-cpu.txt

# Everything else — isolated so it stays cached when only torch's pin changes
COPY pytorch_benchmark/requirements-base.txt /app/requirements-base.txt
RUN pip install --no-cache-dir -r requirements-base.txt

COPY pytorch_benchmark/ /app/pytorch_benchmark/
ENV PYTHONPATH=/app
WORKDIR /app
